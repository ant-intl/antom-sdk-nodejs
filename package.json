{
  "name": "@antom-tech/node",
  "version": "0.1.1",
  "description": "Antom server-side SDK for Node.js with TypeScript definitions",
  "repository": {
    "type": "git",
    "url": "https://github.com/ant-intl/antom-sdk-nodejs.git"
  },
  "type": "commonjs",
  "main": "./dist/cjs/index.js",
  "types": "./dist/cjs/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/esm/index.d.ts",
        "default": "./dist/esm/index.js"
      },
      "require": {
        "types": "./dist/cjs/index.d.ts",
        "module-sync": "./dist/esm/index.js",
        "default": "./dist/cjs/index.js"
      }
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "resources",
    "README.md",
    "LEGAL.md"
  ],
  "publishConfig": {
    "registry": "https://registry.npmjs.org/",
    "access": "public"
  },
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "test": "npm run build && node --test test/*.test.mjs",
    "prepack": "npm run build",
    "check:package": "node scripts/check-package.mjs",
    "release": "node scripts/release.mjs",
    "snapshot:exports:update": "npm run build && node scripts/update-export-snapshots.mjs"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "^5.9.3"
  }
}
